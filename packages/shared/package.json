{
  "name": "@repo/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.js"
      },
      "require": {
        "types": "./dist/schemas/index.d.cts",
        "default": "./dist/schemas/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine/index.d.ts",
        "default": "./dist/engine/index.js"
      },
      "require": {
        "types": "./dist/engine/index.d.cts",
        "default": "./dist/engine/index.cjs"
      }
    },
    "./content": {
      "import": {
        "types": "./dist/content/index.d.ts",
        "default": "./dist/content/index.js"
      },
      "require": {
        "types": "./dist/content/index.d.cts",
        "default": "./dist/content/index.cjs"
      }
    },
    "./persistence": {
      "import": {
        "types": "./dist/persistence/index.d.ts",
        "default": "./dist/persistence/index.js"
      },
      "require": {
        "types": "./dist/persistence/index.d.cts",
        "default": "./dist/persistence/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "validate-content": "tsx src/content/validate.ts",
    "prepare": "tsup"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
